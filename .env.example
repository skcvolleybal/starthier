# Copy to ".env" and fill with strong values for production.
# DO NOT commit your real ".env" (add it to .gitignore).

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me-user

WORDPRESS_DB_HOST=mysql_db:3306
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=change-me-user
WORDPRESS_DB_NAME=wordpress

# Optional: wpcli host override if you want it different
# WORDPRESS_DB_HOST_CLI=mysql_db